# ActiveModel::Dirty — change tracking over the Attributes API (the gem's
# Dirty also requires Attributes; documented quirk in oracle/cases.rb).
#
# Deviation: class-body defs shadow module methods in Crystal, so Dirty
# cannot override __write_attribute itself — the attribute writer chains
# (attributes.cr) call __dirty_track_write when Dirty is in the
# ancestors. Per-attribute queries (<attr>_was/_changed?/_change/
# _previously_changed?/_previous_change) are generated by the attribute
# macro under the same condition.
module ActiveModel
  module Dirty
    @__changed_attributes = Hash(String, Value).new
    @__previous_changes = Hash(String, Array(Value)).new

    def __dirty_track_write(key : String, val : ActiveModel::Value) : Nil
      old = @__attributes.has_key?(key) ? @__attributes[key] : __attribute_default(key)
      @__attributes[key] = val
      if val == old
        @__changed_attributes.delete(key)
      else
        @__changed_attributes[key] = old unless @__changed_attributes.has_key?(key)
      end
    end

    def changed? : Bool
      !@__changed_attributes.empty?
    end

    def changed : Array(String)
      @__changed_attributes.keys
    end

    def changed_attributes : Hash(String, ActiveModel::Value)
      @__changed_attributes.dup
    end

    def changes : Hash(String, Array(ActiveModel::Value))
      result = Hash(String, Array(Value)).new
      @__changed_attributes.each_key do |k|
        pair = Array(Value).new
        pair << @__changed_attributes[k]
        pair << @__attributes[k]
        result[k] = pair
      end
      result
    end

    def changes_applied : Nil
      @__previous_changes = changes
      @__changed_attributes.clear
    end

    def restore_attributes(attrs : Nil | Array(String) = nil)
      keys = attrs || @__changed_attributes.keys.dup
      keys.each do |k|
        @__attributes[k] = @__changed_attributes[k]
        @__changed_attributes.delete(k)
      end
    end

    def previous_changes : Hash(String, Array(ActiveModel::Value))
      @__previous_changes
    end
  end
end
